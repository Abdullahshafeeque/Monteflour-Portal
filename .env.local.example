# Supabase — Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, NEVER expose this to the browser

# Razorpay — dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Product & pricing (not secret — safe to be NEXT_PUBLIC)
NEXT_PUBLIC_PRODUCT_NAME=Monteflour — 8 Grain Multigrain Flour (1kg)
NEXT_PUBLIC_PRODUCT_PRICE=199
NEXT_PUBLIC_SHIPPING_FEE=0
NEXT_PUBLIC_FREE_SHIPPING_ABOVE=499
